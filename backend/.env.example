# KSP-CrimePilot Backend Environment Variables Template
# Copy this file to .env and fill in the values.

# Google Gemini API key (starts with AIzaSy)
GEMINI_API_KEY="AIzaSy..."

# JWT secret key for signing tokens (generate a long random key in production)
JWT_SECRET_KEY="ksp_crimepilot_super_secret_key"

# CORS configuration
CORS_ALLOWED_ORIGINS="*"

# Passwords for mock users (defaults to password123)
MOCK_PASSWORD_INVESTIGATOR="password123"
MOCK_PASSWORD_ANALYST="password123"
MOCK_PASSWORD_SUPERVISOR="password123"
MOCK_PASSWORD_POLICYMAKER="password123"
MOCK_PASSWORD_CONSTABLE="password123"
